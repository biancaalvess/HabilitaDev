{
  "name": "HabilitaDev - Produção",
  "description": "Configurações para ambiente de produção",
  "database": {
    "url": "postgresql://user:password@localhost:5432/habilitadev",
    "logging": false,
    "synchronize": false,
    "ssl": true
  },
  "api": {
    "timeout": 10000,
    "retries": 1,
    "cache": {
      "enabled": true,
      "ttl": 600000
    }
  },
  "security": {
    "jwt": {
      "expiresIn": "1d",
      "refreshExpiresIn": "7d"
    },
    "bcrypt": {
      "rounds": 12
    },
    "rateLimit": {
      "max": 50,
      "windowMs": 900000
    }
  },
  "logging": {
    "level": "info",
    "format": "json",
    "console": false,
    "file": true
  },
  "monitoring": {
    "enabled": true,
    "analytics": true,
    "errorReporting": true
  },
  "features": {
    "mockData": false,
    "offlineMode": false,
    "debugMode": false,
    "hotReload": false
  }
}
