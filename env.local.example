# UTF-8 — copie para .env.local e ajuste portas (Java / Next).

# Spring Boot — URL pública (cliente) e só-servidor (prioridade nas API Routes / serverGetQuestions).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080

# Alternativa: uma variável para o Java (proxy). Se for http(s)://, o cliente usa BFF em /api.
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Origem do Next (BFF absoluto em fetch no servidor).
NEXT_PUBLIC_APP_URL=http://localhost:3001

NODE_ENV=development
JWT_SECRET="dev-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=10

NEXT_PUBLIC_APP_NAME="HabilitaDev"

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
CACHE_TTL=300000
CACHE_MAX_SIZE=100
LOG_LEVEL=debug
LOG_FORMAT=json
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true
