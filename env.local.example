# Configurações de Desenvolvimento Local
NODE_ENV=development

# Configurações de Autenticação
JWT_SECRET="dev-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=10

# Configurações da API — ver env.example (Opção A: NEXT_PUBLIC_API_URL=https://... só o Java)
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_BACKEND_URL="https://habilitadev-backendd.onrender.com"
BACKEND_URL="https://habilitadev-backendd.onrender.com"
# NEXT_PUBLIC_APP_API_BASE=/api

# Configurações de Desenvolvimento
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="HabilitaDev"

# Configurações de Segurança
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Configurações de Cache
CACHE_TTL=300000
CACHE_MAX_SIZE=100

# Configurações de Log
LOG_LEVEL=debug
LOG_FORMAT=json

# Configurações de Monitoramento
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true
