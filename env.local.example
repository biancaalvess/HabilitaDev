# UTF-8 — copie para .env.local e ajuste portas (Java / Next).

# Spring Boot (proxy server-side; o browser nunca chama esta URL directamente).
NEXT_PUBLIC_API_URL=http://localhost:8081

# Origem do Next (BFF absoluto em fetch no servidor).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Opcional: URL do Java só no servidor (prioridade sobre NEXT_PUBLIC_API_URL nas API Routes).
# BACKEND_URL=http://localhost:8081

NODE_ENV=development
JWT_SECRET="dev-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=10

NEXT_PUBLIC_APP_NAME="HabilitaDev"

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
CACHE_TTL=300000
CACHE_MAX_SIZE=100
LOG_LEVEL=debug
LOG_FORMAT=json
ENABLE_ANALYTICS=true
ENABLE_ERROR_REPORTING=true
