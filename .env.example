# Copy to .env.local and adjust values. Never commit real secrets.

# Spring Boot base URL (no trailing slash). Server-side routes prefer BACKEND_URL.
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Alternative: single public URL for the Java API (when not using BACKEND_URL).
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Next.js origin (server-side fetch to this app’s /api/proxy/*).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Client API prefix when NEXT_PUBLIC_API_URL is a path (e.g. /api). Default: /api
# NEXT_PUBLIC_APP_API_BASE=/api

NODE_ENV=development

# JWT (change in production)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Email (optional)
EMAIL_PROVIDER=console
FROM_EMAIL=noreply@example.com
FROM_NAME=HabilitaDev
