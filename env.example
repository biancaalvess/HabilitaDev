# UTF-8 — ficheiro .env.local na raiz do Next (mesmas chaves).

# URL completa do Spring Boot (Java). O Next usa isto nas API Routes (proxy), não no browser.
# Exemplo local: http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:8081

# URL do próprio site Next (fetch server-side → /api/proxy/...).
# Exemplo: http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Opcional: só no servidor (não vai no bundle do cliente). Se definido, tem prioridade sobre NEXT_PUBLIC_API_URL.
# BACKEND_URL=http://localhost:8081

# Compatibilidade com setups antigos (só se não usares NEXT_PUBLIC_API_URL como URL do Java):
# NEXT_PUBLIC_BACKEND_URL=https://seu-backend.example.com

# Prefixo das rotas BFF no cliente (por defeito /api → pedidos a /api/proxy/...).
# NEXT_PUBLIC_APP_API_BASE=/api

NODE_ENV=development

JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=10

EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL="noreply@habilitadev.com"
FROM_NAME="HabilitaDev"
