# UTF-8 — ficheiro .env.local na raiz do Next (mesmas chaves).

# URL do Spring Boot (Java) — usada no browser quando precisas de expor a mesma origem (ex.: fetch direto).
# Exemplo local: http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Mesma URL só no servidor (não entra no bundle do cliente). Tem prioridade sobre NEXT_PUBLIC_* nas API Routes.
BACKEND_URL=http://localhost:8080

# Alternativa única: URL completa do Java (proxy no servidor). Se for http(s)://, o cliente usa BFF em /api.
# NEXT_PUBLIC_API_URL=http://localhost:8080

# URL do próprio site Next (fetch server-side → /api/proxy/...).
# Exemplo: http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Prefixo das rotas BFF no cliente (por defeito /api → pedidos a /api/proxy/...).
# NEXT_PUBLIC_APP_API_BASE=/api

NODE_ENV=development

JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=10

EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL="noreply@habilitadev.com"
FROM_NAME="HabilitaDev"
