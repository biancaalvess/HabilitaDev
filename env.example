# Configurações de Autenticação
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Configurações da API (Spring Boot em /api/v1, JSON snake_case)
#
# Opção A — recomendada: uma variável com a URL pública do Java (sem barra no fim).
# O cliente Next usa automaticamente NEXT_PUBLIC_APP_API_BASE=/api para /api/proxy/...
# NEXT_PUBLIC_API_URL=https://SEU-SUBDOMINIO.onrender.com
#
# Opção B — dev/local: URL do Java separada do prefixo do Next
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_BACKEND_URL="https://habilitadev-backendd.onrender.com"
# Servidor (API Routes) pode usar só BACKEND_URL se preferir:
# BACKEND_URL="https://habilitadev-backendd.onrender.com"
#
# Se usares Opção A (NEXT_PUBLIC_API_URL=https://...), não precisas de NEXT_PUBLIC_BACKEND_URL.
# CORS no Render: CORS_ALLOWED_ORIGINS deve incluir o origin do Vercel e http://localhost:3001

# Configurações de Desenvolvimento
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Configurações de Segurança
BCRYPT_ROUNDS=10
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Configurações de Email
# Opções: 'resend', 'sendgrid', 'console' (console apenas para desenvolvimento)
EMAIL_PROVIDER=resend

# Resend API Key (obtenha em https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key_here

# SendGrid API Key (se usar SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Configurações do remetente
FROM_EMAIL="noreply@habilitadev.com"
FROM_NAME="HabilitaDev"